# Copy to .env and fill in. Variables prefixed VITE_ are bundled into the browser build,
# so only put public/publishable keys here.

# Supabase (Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Alternative to VITE_SUPABASE_ANON_KEY (used as a fallback in src/supabase.ts)
# VITE_SUPABASE_PUBLISHABLE_KEY=

# Google Maps (Places Autocomplete + Geocoding). Restrict this key by HTTP referrer.
VITE_GOOGLE_MAPS_API_KEY=

# CARTO basemap tiles (raster tiles require a key). Restrict by domain in the CARTO dashboard.
VITE_CARTO_API_KEY=

# PostHog analytics
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Edge function secrets are NOT read from .env. Set them with:
#   supabase secrets set SIGHTENGINE_USER=... SIGHTENGINE_SECRET=...
